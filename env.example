# ============================================
# Proxmox API 설정 (조회용)
# ============================================
# Proxmox 서버의 API URL
# 형식: https://proxmox-server-ip:8006/api2/json
PROXMOX_API_URL=https://192.168.2.11:8006/api2/json

# Proxmox API Token ID
# Proxmox 웹 UI에서 생성: Datacenter > Permissions > API Tokens
# 형식: user@pam!token_name (예: admin@pam!terraform-token)
PROXMOX_API_TOKEN_ID=root@pam!terraform-admin


# Proxmox API Token Secret
# Token 생성 시 발급받은 Secret 값
PROXMOX_API_TOKEN_SECRET=69d75d7e-620a-4b97-8d1e-db36d66fed84

# TLS 인증서 검증 비활성화 여부
# 자체 서명 인증서 사용 시 true로 설정
# 프로덕션 환경에서는 false 권장
PROXMOX_TLS_INSECURE=true

# ============================================
# Terraform 설정 (제어용)
# ============================================
# 주의: Terraform은 TF_VAR_ 접두사를 가진 환경변수를 자동으로 읽습니다.
# run.sh 스크립트가 자동으로 변환하므로, 아래 변수들은 설정하지 않아도 됩니다.
# (PROXMOX_API_URL, PROXMOX_API_TOKEN_ID, PROXMOX_API_TOKEN_SECRET가 자동 변환됨)

# Terraform TLS 검증 설정 (선택사항)
# PROXMOX_TLS_INSECURE와 동일한 값 사용
# TF_VAR_proxmox_tls_insecure=false

# ============================================
# Ansible 설정
# ============================================
# SSH 접속 사용자명
# 생성된 VM에 Ansible이 접속할 때 사용하는 사용자
# 일반적으로 root 또는 sudo 권한이 있는 사용자
ANSIBLE_SSH_USER=root

# SSH 개인키 파일 경로
# VM에 SSH 접속할 때 사용할 개인키
# 절대 경로 또는 ~/.ssh/id_rsa 형식 사용 가능
ANSIBLE_SSH_PRIVATE_KEY_FILE=~/.ssh/id_rsa

# SSH 공개키 파일 경로 (Cloud-init 자동 주입용)
# Cloud-init으로 VM 생성 시 SSH 키를 자동으로 주입합니다
# 템플릿에 SSH 키를 미리 포함시킬 필요 없음
# 기본값: 개인키 파일명에 .pub 추가 (예: ~/.ssh/id_rsa.pub)
ANSIBLE_SSH_PUBLIC_KEY_FILE=~/.ssh/id_rsa.pub

# ============================================
# 백엔드 서버 설정
# ============================================
# 백엔드 서버 바인딩 주소
BACKEND_HOST=0.0.0.0

# 백엔드 서버 포트
BACKEND_PORT=8000

# ============================================
# 프론트엔드 설정
# ============================================
# 프론트엔드 포트 (CORS 설정에 사용됨)
FRONTEND_PORT=5173
