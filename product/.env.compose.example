# Copy this file to product/.env before running Docker Compose.
# Keep product/.env private; it contains database and provider secrets.

HEIMDALL_CONTROL_POSTGRES_DB=heimdall
HEIMDALL_CONTROL_POSTGRES_USER=heimdall
# Use a long random URL-safe password. Good characters are letters, numbers,
# hyphen, underscore, period, and tilde. If you use other characters, URL-encode
# them in HEIMDALL_DATABASE_URL.
HEIMDALL_CONTROL_POSTGRES_PASSWORD=change-me-use-a-long-random-url-safe-password
HEIMDALL_DATABASE_URL=postgresql://heimdall:change-me-use-a-long-random-url-safe-password@heimdall-postgres:5432/heimdall

# Managed project PostgreSQL settings. Heimdall provisions per-project
# databases/roles and injects DATABASE_URL only at deploy time. Back up
# project-postgres before testing destructive purge outside disposable data.
HEIMDALL_PROJECT_POSTGRES_DB=postgres
HEIMDALL_PROJECT_POSTGRES_USER=postgres
HEIMDALL_PROJECT_POSTGRES_PASSWORD=change-me-use-a-different-long-random-url-safe-password
HEIMDALL_PROJECT_DATABASE_ADMIN_URL=postgresql://postgres:change-me-use-a-different-long-random-url-safe-password@project-postgres:5432/postgres
HEIMDALL_PROJECT_DATABASE_APP_HOST=project-postgres
HEIMDALL_PROJECT_DATABASE_APP_PORT=5432
HEIMDALL_PROJECT_DATABASE_NETWORK=heimdall-project-db

# Replace 192.0.2.10 with the VM IP address reachable from browsers and from
# containers on this VM. Do not use 127.0.0.1 for HEIMDALL_PREVIEW_HOST when the
# API runs in Docker.
HEIMDALL_PUBLIC_BASE_URL=http://192.0.2.10:8000
HEIMDALL_PREVIEW_HOST=192.0.2.10
# Optional: use only when API-side health checks need a different address than
# browser preview URLs, for example host.docker.internal on Docker Desktop.
HEIMDALL_PREVIEW_HEALTH_HOST=
HEIMDALL_PREVIEW_PORT_START=18000
HEIMDALL_PREVIEW_PORT_END=18999
VITE_API_BASE_URL=http://192.0.2.10:8000

HEIMDALL_API_PORT=8000
HEIMDALL_WEB_PORT=8080
# Host runtime mount for API deployment logs, Git workspaces, and secret files.
# Uploaded service .env bundles are stored below:
#   ${HEIMDALL_RUNTIME_DIR_HOST}/secrets/env-bundles
# inside the API container this is:
#   /var/lib/heimdall/secrets/env-bundles
HEIMDALL_RUNTIME_DIR_HOST=/srv/heimdall/runtime
HEIMDALL_CONTROL_POSTGRES_DATA_DIR=/srv/heimdall/control-postgres
HEIMDALL_PROJECT_POSTGRES_DATA_DIR=/srv/heimdall/project-postgres

# Optional provider integration. Leave blank until you are ready to register
# GitHub or GitLab projects and webhooks.
HEIMDALL_GITHUB_API_TOKEN=
HEIMDALL_GITHUB_WEBHOOK_SECRET=
HEIMDALL_GITLAB_BASE_URL=
HEIMDALL_GITLAB_API_TOKEN=
HEIMDALL_GITLAB_WEBHOOK_SECRET=
